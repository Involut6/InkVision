{
  "name": "@inkvision/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InkVision Creatives REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "prebuild": "pnpm --filter @inkvision/shared-types build && rm -rf dist && prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@inkvision/shared-types": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^7.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "@eslint/js": "9.39.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
