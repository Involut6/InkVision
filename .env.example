# =============================================================================
# InkVision Creatives — environment template
#
# Copy to `.env` at the repository root for local development:
#     cp .env.example .env
#
# Both apps also read app-local files (apps/api/.env, apps/web/.env.local) if
# you prefer to split configuration per deployment target. Every value below is
# a PLACEHOLDER — never commit real secrets.
#
# Variables are validated at startup (apps/api/src/config/env.validation.ts and
# apps/web/src/lib/env.ts). The process exits with a readable report when a
# required value is missing or malformed.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared / local docker compose
# -----------------------------------------------------------------------------
POSTGRES_USER=inkvision
POSTGRES_PASSWORD=inkvision_dev_password
POSTGRES_DB=inkvision
POSTGRES_PORT=5432

# =============================================================================
# API (apps/api) — NestJS. NONE of these may be exposed to the browser.
# =============================================================================
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Mounted under this prefix: http://localhost:4000/api/v1
API_GLOBAL_PREFIX=api
LOG_LEVEL=debug

# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://inkvision:inkvision_dev_password@localhost:5432/inkvision?schema=public
# Separate database used by `pnpm test:integration`. It is migrated and TRUNCATED
# by the test harness, so it must never point at a database holding real data.
TEST_DATABASE_URL=postgresql://inkvision:inkvision_test_password@localhost:5433/inkvision_test?schema=public

# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000
# Public base URL of the website, used in emails, canonicals and signed links.
PUBLIC_WEB_URL=http://localhost:3000
# Public base URL of the API itself, used to build absolute download links.
PUBLIC_API_URL=http://localhost:4000

# --- Authentication ----------------------------------------------------------
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-value-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# Cookie domain for the refresh/session cookies. Leave blank for host-only
# cookies (correct when API and web share a registrable domain is NOT assumed).
AUTH_COOKIE_DOMAIN=
# Set to `true` whenever the API is served over HTTPS (required in production).
AUTH_COOKIE_SECURE=false
# `lax` works when web and API share a site; use `none` (with secure=true) for
# cross-site deployments such as web on Vercel + API on Fly.io.
AUTH_COOKIE_SAMESITE=lax
# Secret used to sign the double-submit CSRF token. openssl rand -base64 32
CSRF_SECRET=replace-me-with-a-long-random-csrf-secret-value

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_LIMIT=5
ENQUIRY_RATE_LIMIT_LIMIT=5

# --- Email provider ---------------------------------------------------------
# `console` logs rendered emails instead of sending (default for development).
# `smtp` sends through the SMTP settings below (works with mailpit locally).
EMAIL_PROVIDER=console
EMAIL_FROM="InkVision Creatives <hello@example.com>"
# Business inbox that receives new-enquiry notifications.
EMAIL_NOTIFICATIONS_TO=enquiries@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- File storage -----------------------------------------------------------
# `local` keeps uploads and product files on disk OUTSIDE any public directory.
# `s3` uses the S3-compatible settings below.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.local-storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Max accepted upload size in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760

# --- Commerce ---------------------------------------------------------------
# Commerce stays OFF until a provider is configured and tested end to end.
# When false the checkout endpoint returns 503 and the storefront shows
# products as "enquire" only.
COMMERCE_ENABLED=false
# `none` (no provider) | `paystack` | `stripe`
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret used to sign time-limited digital download links. openssl rand -base64 32
DOWNLOAD_LINK_SECRET=replace-me-with-a-long-random-download-secret
DOWNLOAD_LINK_TTL=900
DOWNLOAD_MAX_ATTEMPTS=5

# --- Optional integrations --------------------------------------------------
# Scheduling provider. Leave blank to hide the "book a call" affordance; the
# enquiry form works independently of this.
SCHEDULING_PROVIDER=
SCHEDULING_EMBED_URL=
# Swagger is served at /api/docs. In production it additionally requires the
# basic-auth credentials below; leave blank in production to disable it.
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=

# =============================================================================
# WEB (apps/web) — Next.js.
# Only NEXT_PUBLIC_* values reach the browser. Keep secrets out of them.
# =============================================================================
# Server-side base URL the Next.js server uses to reach the API. In a container
# network this is often an internal host (e.g. http://api:4000).
API_BASE_URL=http://localhost:4000/api/v1
# Browser-visible base URL for the same API (used by TanStack Query mutations).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Canonical site URL — drives canonical tags, sitemap.xml and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=InkVision Creatives
# Mirrors COMMERCE_ENABLED so the storefront renders the correct affordances.
# The server remains the only authority on whether a purchase can proceed.
NEXT_PUBLIC_COMMERCE_ENABLED=false
